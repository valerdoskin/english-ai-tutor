# === Telegram ===
# Токен бота от @BotFather
BOT_TOKEN=

# Домен, на котором будет работать приложение (без https:// и без слэша)
# Например: myapp.onrender.com
WEBHOOK_DOMAIN=

# === LLM (Groq — бесплатный, основной) ===
# Получить: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# === LLM (DeepSeek — fallback) ===
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# === Speech-to-Text (HuggingFace) ===
HF_TOKEN=
HF_WHISPER_MODEL=openai/whisper-large-v3

# === Speech-to-Text (Replicate — fallback) ===
REPLICATE_API_KEY=

# === Настройки приложения ===
# Максимальная длина истории диалога
MAX_HISTORY=10

# Количество вопросов в тесте уровня
TEST_QUESTIONS_COUNT=12

# Количество слов для ежедневного повторения (SRS)
DAILY_WORDS_LIMIT=20

# Количество уроков в модуле
LESSONS_PER_MODULE=5

# === Настройки геймификации ===
# XP за завершённый урок
XP_LESSON=20
# XP за правильный ответ в тесте
XP_TEST_QUESTION=5
# XP за выученное слово
XP_WORD=5
# XP за голосовое сообщение
XP_VOICE=10
# XP за ежедневную практику
XP_DAILY=15
# XP за выполненную задачу (TBLT)
XP_TASK=30
