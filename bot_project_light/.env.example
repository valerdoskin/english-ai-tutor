# === Telegram ===
# Токен бота от @BotFather
BOT_TOKEN=

# Домен, на котором будет работать приложение (без https:// и без слэша)
# Например: myapp.onrender.com
WEBHOOK_DOMAIN=

# === LLM (Groq — бесплатный, основной) ===
# Получить: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# === LLM (DeepSeek — fallback) ===
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# === Speech-to-Text (HuggingFace) ===
HF_TOKEN=
HF_WHISPER_MODEL=openai/whisper-large-v3

# === Speech-to-Text (Replicate — fallback) ===
REPLICATE_API_KEY=
